#pragma once

#define WIFI_SSID     "SUA_REDE_WIFI"
#define WIFI_PASSWORD "SUA_SENHA_WIFI"

// IP fixo do proprio bloqueador dentro da sua rede.
// Ajuste pra faixa da sua rede (ex: se seu roteador e 192.168.1.1, use
// algo como 192.168.1.53). Escolha um IP fora da faixa de DHCP do
// roteador pra nao correr risco de conflito.
#define LOCAL_IP_A 192
#define LOCAL_IP_B 168
#define LOCAL_IP_C 0
#define LOCAL_IP_D 53

#define GATEWAY_A 192
#define GATEWAY_B 168
#define GATEWAY_C 0
#define GATEWAY_D 1

#define SUBNET_A 255
#define SUBNET_B 255
#define SUBNET_C 255
#define SUBNET_D 0
